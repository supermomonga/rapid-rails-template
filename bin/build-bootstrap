#!/usr/bin/env ruby
# frozen_string_literal: true

require "base64"

ROOT = File.expand_path("..", __dir__)
SOURCE_ROOT = File.join(ROOT, "src", "rapid_rails_template")
ORDER = %w[errors environment configuration questionnaire generator_options execution_plan runner].freeze

parts = ["# frozen_string_literal: true\n", "# Generated by bin/build-bootstrap. Do not edit.\n"]
ORDER.each do |name|
  parts << File.binread(File.join(SOURCE_ROOT, "#{name}.rb"))
end
payload = Base64.strict_encode64(File.binread(File.join(SOURCE_ROOT, "rails_template.rb")))
parts << "\nrequire \"base64\"\nmodule RapidRailsTemplate\n  APPLICATION_TEMPLATE = Base64.strict_decode64(#{payload.inspect}).freeze\nend\n"
parts << File.binread(File.join(SOURCE_ROOT, "entrypoint.rb"))
content = parts.join("\n")
path = File.join(ROOT, "bootstrap.rb")
File.binwrite(path, content)
puts path
