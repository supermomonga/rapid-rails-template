create_file "test/models/article_test.rb", <<~'RUBY', force: true
  # typed: true

  require "test_helper"

  class ArticleTest < ActiveSupport::TestCase
    test "belongs to a profile and requires a title and body" do
      article = Article.new(profile: profiles(:one))

      assert_not article.valid?
      assert article.errors.of_kind?(:title, :blank)
      assert article.errors.of_kind?(:body, :blank)
    end

    test "starts as a draft" do
      article = profiles(:one).articles.build(title: "New article", body: "New body")

      assert_predicate article, :draft?
    end

    test "destroys articles with their profile" do
      article = articles(:one)

      profiles(:one).destroy!

      assert_not Article.exists?(article.id)
    end
  end
RUBY

create_file "test/policies/article_policy_test.rb", <<~'RUBY', force: true
  # typed: true

  require "test_helper"

  class ArticlePolicyTest < ActiveSupport::TestCase
    test "allows only the owner to create update and destroy" do
      owner = users(:one)
      other = users(:two)
      article = articles(:one)

      assert ArticlePolicy.new(article, user: owner).apply(:create?)
      assert ArticlePolicy.new(article, user: owner).apply(:update?)
      assert ArticlePolicy.new(article, user: owner).apply(:destroy?)
      assert_not ArticlePolicy.new(article, user: other).apply(:create?)
      assert_not ArticlePolicy.new(article, user: other).apply(:update?)
      assert_not ArticlePolicy.new(article, user: other).apply(:destroy?)
    end

    test "shows published articles publicly and adds the signed in users drafts" do
      guest_scope = ArticlePolicy.new(Article, user: nil)
        .apply_scope(Article.all, type: :active_record_relation)
      owner_scope = ArticlePolicy.new(Article, user: users(:two))
        .apply_scope(Article.all, type: :active_record_relation)

      assert_equal [articles(:one).id], guest_scope.ids
      assert_equal [articles(:one).id, articles(:two).id].sort, owner_scope.ids.sort
    end
  end
RUBY

create_file "test/controllers/articles_controller_test.rb", <<~'RUBY', force: true
  # typed: true

  require "test_helper"

  class ArticlesControllerTest < ActionDispatch::IntegrationTest
    include Devise::Test::IntegrationHelpers

    setup do
      @published = T.let(articles(:one), Article)
      @draft = T.let(articles(:two), Article)
    end

    test "shows only published articles to guests" do
      get articles_url

      assert_response :success
      assert_select "#article_#{@published.id}", count: 1
      assert_select "#article_#{@draft.id}", count: 0

      get article_url(@published)
      assert_response :success

      get article_url(@draft)
      assert_response :not_found
    end

    test "shows an owner their own draft" do
      sign_in users(:two)

      get article_url(@draft)

      assert_response :success
      assert_select ".badge", text: "Draft", count: 1
    end

    test "requires authentication for write actions" do
      get new_article_url
      assert_redirected_to new_user_session_url

      post articles_url, params: { article: { title: "Guest", body: "Body", draft: false } }
      assert_redirected_to new_user_session_url

      get edit_article_url(@published)
      assert_redirected_to new_user_session_url

      delete article_url(@published)
      assert_redirected_to new_user_session_url
    end

    test "creates an article for the signed in profile and ignores profile_id" do
      sign_in users(:one)

      get new_article_url
      assert_response :success
      assert_select 'form input[name="article[profile_id]"]', count: 0

      assert_difference("Article.count") do
        post articles_url, params: {
          article: {
            title: "Owned article",
            body: "Owned body",
            draft: false,
            profile_id: profiles(:two).id
          }
        }
      end

      created = T.must(Article.order(:id).last)
      assert_equal profiles(:one), created.profile
      assert_redirected_to article_url(created)
    end

    test "allows an owner to update and destroy their article" do
      sign_in users(:one)

      patch article_url(@published), params: { article: { title: "Updated", body: "Updated body", draft: true } }
      assert_redirected_to article_url(@published)
      assert_equal ["Updated", "Updated body", true], @published.reload.attributes.values_at("title", "body", "draft")

      assert_difference("Article.count", -1) do
        delete article_url(@published)
      end
      assert_redirected_to articles_url
    end

    test "forbids another user from mutating an article" do
      sign_in users(:one)

      get edit_article_url(@draft)
      assert_response :forbidden

      assert_no_changes -> { @draft.reload.title } do
        patch article_url(@draft), params: { article: { title: "Forbidden", body: "Body", draft: false } }
      end
      assert_response :forbidden

      assert_no_difference("Article.count") do
        delete article_url(@draft)
      end
      assert_response :forbidden
    end

    test "paginates visible articles twenty five at a time" do
      30.times do |index|
        profiles(:one).articles.create!(title: "Article #{index}", body: "Body", draft: false)
      end

      get articles_url

      assert_response :success
      assert_select "tbody#articles tr", count: 25
      assert_select 'nav[aria-label="Article pagination"] .join', count: 1
      assert_select '.join > .join-item.btn', count: 4
      assert_select '.join > .btn-active[aria-current="page"]', text: "1", count: 1
      assert_select '.join > .btn-disabled[aria-label=?][aria-disabled="true"]', I18n.t("common.previous"), count: 1
      assert_select '.join > a[href=?]', articles_path(page: 2), text: "2", count: 1
      assert_select '.join > a[href=?][aria-label=?]', articles_path(page: 2), I18n.t("common.next"), count: 1
    end
  end
RUBY

append_to_file "db/seeds.rb", <<~'RUBY'

  sample_users = 10.times.map do |user_index|
    number = user_index + 1
    screen_name = format("sample_user_%02d", number)
    profile = Profile.find_by(screen_name: screen_name)
    if profile
      user = T.must(profile.user)
    else
      user = User.create!(skip_initial_admin_role: true)
      profile = T.must(user.profile)
    end
    profile.update!(screen_name: screen_name, display_name: format("Sample User %02d", number))
    user.passkey_credentials.find_or_create_by!(webauthn_id: "sample-passkey-#{screen_name}") do |passkey|
      passkey.name = "Sample Passkey"
      passkey.public_key = "sample-public-key"
      passkey.sign_count = 0
      passkey.transports = ["internal"]
      passkey.backup_eligible = false
      passkey.backup_state = false
    end

    50.times do |article_index|
      article_number = article_index + 1
      article = profile.articles.find_or_initialize_by(
        title: format("Sample Article %02d-%02d", number, article_number)
      )
      article.body = format("This is article %02d by Sample User %02d.", article_number, number)
      article.draft = article_number > 40
      article.save!
    end

    user
  end

  Notification.published.all_users.find_each do |notification|
    NotificationDeliverySynchronization.call(notification:)
  end

  puts "Sample users (seeded Passkeys are display-only and cannot authenticate):"
  sample_users.each do |user|
    puts "  #{T.must(user.profile).screen_name}: user_id=#{user.id}"
  end
RUBY

create_file "test/models/sample_seed_test.rb", <<~'RUBY', force: true
  # typed: true

  require "test_helper"

  class SampleSeedTest < ActiveSupport::TestCase
    test "creates non-admin sample users and leaves initial admin assignment for the next signup" do
      with_rails_environment("development") do
        2.times { load Rails.root.join("db/seeds.rb").to_s }

        seed_notifications = Notification.published.all_users.where(
          published_at: [
            Time.zone.parse("2026-01-01 09:00:00"),
            Time.zone.parse("2026-01-02 09:00:00"),
            Time.zone.parse("2026-01-03 09:00:00")
          ]
        )
        seed_notification_messages = [
          "新しいお知らせがあります。",
          "サービスの使い方を確認できます。",
          "最新情報をお届けします。"
        ]
        screen_names = (1..10).map { |number| format("sample_user_%02d", number) }
        sample_profiles = Profile.where(screen_name: screen_names).includes(:user).order(:screen_name).to_a
        assert_equal 10, sample_profiles.count
        sample_users = sample_profiles.map { |profile| T.must(profile.user) }

        sample_users.each do |user|
          assert_not user.has_role?(:admin)
          assert_equal 1, user.passkey_credentials.count
          seeded_deliveries = user.notification_deliveries.published.unopened.where(
            notification: seed_notifications
          )
          assert_equal 3, seeded_deliveries.count
          articles = T.must(user.profile).articles
          assert_equal 50, articles.count
          assert_equal 10, articles.where(draft: true).count
          assert_equal 40, articles.where(draft: false).count
        end
        assert_equal seed_notification_messages.sort, seed_notifications.map(&:message_plain_text).sort
        assert_equal 500, Article.where(profile: sample_profiles).count

        signed_up_user = User.create!
        assert signed_up_user.has_role?(:admin)
      end
    end

    private
      def with_rails_environment(environment)
        previous_environment = Rails.env
        Rails.env = environment
        yield
      ensure
        Rails.env = previous_environment
      end
  end
RUBY

