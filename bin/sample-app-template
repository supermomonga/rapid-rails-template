article_migrations = Dir.glob("db/migrate/*_create_articles.rb")
raise "CreateArticles migrationが一意ではありません" unless article_migrations.one?

create_file article_migrations.first, <<~RUBY, force: true
  class CreateArticles < ActiveRecord::Migration[8.1]
    def change
      create_table :articles do |t|
        t.references :profile, null: false, foreign_key: { on_delete: :cascade }
        t.string :title, null: false
        t.text :body, null: false
        t.boolean :draft, null: false, default: true
        t.timestamps
      end
    end
  end
RUBY

