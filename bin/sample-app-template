create_file "app/policies/article_policy.rb", <<~'RUBY', force: true
  # typed: true

  class ArticlePolicy < ApplicationPolicy
    authorize :user, optional: true

    T::Sig::WithoutRuntime.sig { returns(T::Boolean) }
    def create?
      owner?
    end

    T::Sig::WithoutRuntime.sig { returns(T::Boolean) }
    def update?
      owner?
    end

    T::Sig::WithoutRuntime.sig { returns(T::Boolean) }
    def destroy?
      owner?
    end

    scope_for :active_record_relation do |relation|
      T.bind(self, ArticlePolicy)
      published = relation.where(draft: false)
      policy_user = user
      policy_user ? published.or(relation.where(profile_id: T.must(policy_user.profile).id)) : published
    end

    private

    def owner?
      policy_user = user
      !policy_user.nil? && record.profile_id == T.must(policy_user.profile).id
    end
  end
RUBY

create_file "app/controllers/articles_controller.rb", <<~'RUBY', force: true
  # typed: true

  class ArticlesController < ApplicationController
    extend T::Sig

    before_action :authenticate_user!, only: %i[new create edit update destroy]
    before_action :set_article, only: %i[edit update destroy]

    sig { void }
    def index
      visible_articles = authorized_scope(Article.all).order(created_at: :desc, id: :desc)
      @pagy, @articles = pagy(:offset, visible_articles, limit: 25)
    end

    sig { void }
    def show
      @article = authorized_scope(Article.all).find(params.expect(:id))
    end

    sig { void }
    def new
      @article = T.must(account_user.profile).articles.build
      authorize! @article, to: :create?
    end

    sig { void }
    def edit
      authorize! @article, to: :update?
    end

    sig { void }
    def create
      @article = Article.new(article_params)
      @article.profile = T.must(account_user.profile)
      authorize! @article, to: :create?

      if @article.save
        redirect_to @article, notice: I18n.t("articles.create.notice")
      else
        render :new, status: :unprocessable_content
      end
    end

    sig { void }
    def update
      authorize! @article, to: :update?

      if @article.update(article_params)
        redirect_to @article, notice: I18n.t("articles.update.notice"), status: :see_other
      else
        render :edit, status: :unprocessable_content
      end
    end

    sig { void }
    def destroy
      authorize! @article, to: :destroy?
      @article.destroy!
      redirect_to articles_path, notice: I18n.t("articles.destroy.notice"), status: :see_other
    end

    private

    def account_user
      T.must(current_user)
    end

    def set_article
      @article = Article.find(params.expect(:id))
    end

    def article_params
      params.expect(article: %i[title body draft])
    end
  end
RUBY

