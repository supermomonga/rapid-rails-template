#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "net/http"
require "open3"
require "socket"
require "tmpdir"
require "timeout"
require_relative "../src/rapid_rails_template/evidence"

ROOT = File.expand_path("..", __dir__)
SAMPLE = File.join(ROOT, "sample")
DESTINATION = File.join(ROOT, "docs/evidence")
COMMON_OPTIONS = [
  "--app-id=sample",
  "--app-name=Sample App",
  "--pwa=use",
  "--web-push=use",
  "--active-job=solid_queue",
  "--job-operations=enable",
  "--maintenance-tasks=enable",
  "--solid-cache=use",
  "--additional-login-methods=siwe",
  "--profile-features=screen_name,display_name,avatar",
  "--api=enable",
  "--action-cable=solid_cable",
  "--mail=use",
  "--default-locale=ja"
].freeze
VARIANTS = {
  "full-ja" => { scenario_set: "full", additional_login_methods: %w[siwe], locale: "ja" }
}.freeze

def run!(*command, env: {}, chdir: ROOT)
  puts "+ #{command.join(" ")}"
  success = system(env, *command, chdir: chdir)
  raise "コマンドが失敗しました: #{command.join(" ")}" unless success
end

def verify_thruster_cache!
  listeners = 2.times.map { TCPServer.new("127.0.0.1", 0) }
  http_port, target_port = listeners.map { |listener| listener.addr.fetch(1) }
  listeners.each(&:close)

  runner = <<~'RUBY'
    require "stringio"
    require "vips"

    png = Vips::Image.black(8, 8).write_to_buffer(".png")
    blob = ActiveStorage::Blob.create_and_upload!(
      io: StringIO.new(png), filename: "thruster-cache-probe.png", content_type: "image/png"
    )
    variant = blob.variant(resize_to_limit: [4, 4])
    path = Rails.application.routes.url_helpers.rails_storage_proxy_path(variant)
    puts "THRUSTER_CACHE_PROBE=#{blob.id}\t#{path}"
  RUBY
  stdout, stderr, status = Open3.capture3(
    { "RAILS_ENV" => "test" }, File.join(SAMPLE, "bin/rails"), "runner", runner, chdir: SAMPLE
  )
  raise "Thruster cache probeの作成に失敗しました: #{stderr}" unless status.success?

  marker = stdout.lines.find { |line| line.start_with?("THRUSTER_CACHE_PROBE=") }
  raise "Thruster cache probeのURLを取得できませんでした: #{stdout}" unless marker

  blob_id, path = marker.delete_prefix("THRUSTER_CACHE_PROBE=").strip.split("\t", 2)
  environment = {
    "RAILS_ENV" => "test",
    "THRUSTER_HTTP_PORT" => http_port.to_s,
    "THRUSTER_TARGET_PORT" => target_port.to_s,
    "THRUSTER_LOG_REQUESTS" => "0"
  }
  output = +""
  server_pid = nil
  reader_thread = nil
  Open3.popen2e(
    environment,
    File.join(SAMPLE, "bin/thrust"), File.join(SAMPLE, "bin/rails"), "server",
    chdir: SAMPLE
  ) do |stdin, server_output, wait_thread|
    stdin.close
    server_pid = wait_thread.pid
    reader_thread = Thread.new { output << server_output.read }
    uri = URI("http://127.0.0.1:#{http_port}#{path}")
    first = nil
    Timeout.timeout(30) do
      loop do
        first = Net::HTTP.get_response(uri)
        break if first.is_a?(Net::HTTPSuccess)

        sleep 0.1
      rescue EOFError, Errno::ECONNREFUSED, Errno::ECONNRESET
        sleep 0.1
      end
    end
    second = Net::HTTP.get_response(uri)
    raise "Thruster cache初回requestがmissではありません: #{first["X-Cache"].inspect}" unless first["X-Cache"] == "miss"
    raise "Thruster cache再requestがhitではありません: #{second["X-Cache"].inspect}" unless second["X-Cache"] == "hit"
    raise "Thruster cacheのresponse bodyが一致しません" unless first.body == second.body
  ensure
    begin
      Process.kill("TERM", server_pid) if server_pid
    rescue Errno::ESRCH
      nil
    end
    wait_thread.join
    reader_thread.join
  end
ensure
  reader_thread&.join
  if blob_id
    _stdout, cleanup_stderr, cleanup_status = Open3.capture3(
      { "RAILS_ENV" => "test" }, File.join(SAMPLE, "bin/rails"), "runner",
      "ActiveStorage::Blob.find(#{Integer(blob_id)}).purge", chdir: SAMPLE
    )
    raise "Thruster cache probeの削除に失敗しました: #{cleanup_stderr}" unless cleanup_status.success?
  end
end

run!(File.join(ROOT, "bin/build-bootstrap"))
run!(File.join(ROOT, "bin/verify-bootstrap"))
source_fingerprint = RapidRailsTemplate::Evidence.fingerprint(ROOT)
base_commit, status = Open3.capture2("git", "rev-parse", "HEAD", chdir: ROOT)
raise "base commitを取得できません" unless status.success?

staging_root = Dir.mktmpdir(".evidence-", ROOT)
begin
  manifests = {}
  VARIANTS.each do |variant, metadata|
    FileUtils.rm_rf(SAMPLE)
    run!(RbConfig.ruby, File.join(ROOT, "bootstrap.rb"), *COMMON_OPTIONS, SAMPLE)
    run!(File.join(SAMPLE, "bin/rails"), "test", chdir: SAMPLE)
    verify_thruster_cache!
    run!(File.join(SAMPLE, "bin/rubocop"), chdir: SAMPLE)

    playwright = File.join(SAMPLE, "node_modules/.bin/playwright")
    raise "Playwright CLIが生成されていません: #{playwright}" unless File.executable?(playwright)
    run!(playwright, "install", "chromium", chdir: SAMPLE)
    run!(File.join(SAMPLE, "bin/rails"), "test:system", chdir: SAMPLE)

    output_directory = File.join(staging_root, variant)
    FileUtils.mkdir_p(output_directory)
    capture_environment = {
      "RAILS_ENV" => "test",
      "EVIDENCE_OUTPUT_DIR" => output_directory,
      "PLAYWRIGHT_CLI_EXECUTABLE_PATH" => playwright
    }
    run!(File.join(SAMPLE, "bin/rails"), "evidence:capture", env: capture_environment, chdir: SAMPLE)
    manifests[variant] = RapidRailsTemplate::Evidence.finalize_variant(
      directory: output_directory,
      scenario_set: metadata.fetch(:scenario_set),
      additional_login_methods: metadata.fetch(:additional_login_methods),
      locale: metadata.fetch(:locale),
      source_fingerprint: source_fingerprint,
      base_commit: base_commit.strip
    )
  end

  RapidRailsTemplate::Evidence.write_index(staging_root, manifests)
  RapidRailsTemplate::Evidence.verify(root: ROOT, evidence_root: staging_root)

  backup = "#{DESTINATION}.backup-#{Process.pid}"
  FileUtils.rm_rf(backup)
  File.rename(DESTINATION, backup) if File.exist?(DESTINATION)
  begin
    File.rename(staging_root, DESTINATION)
    FileUtils.rm_rf(backup)
  rescue Exception
    File.rename(backup, DESTINATION) if File.exist?(backup) && !File.exist?(DESTINATION)
    raise
  end
ensure
  FileUtils.rm_rf(staging_root) if File.exist?(staging_root)
end

puts "UI evidence updated: #{DESTINATION}"
