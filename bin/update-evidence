#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "net/http"
require "open3"
require "securerandom"
require "tmpdir"
require_relative "../src/rapid_rails_template/evidence"

ROOT = File.expand_path("..", __dir__)
SAMPLE = File.join(ROOT, "sample")
DESTINATION = File.join(ROOT, "docs/evidence")
COMMON_OPTIONS = [
  "--app-id=sample",
  "--app-name=Sample App",
  "--pwa=use",
  "--web-push=use",
  "--active-job=solid_queue",
  "--job-operations=enable",
  "--maintenance-tasks=enable",
  "--solid-cache=use",
  "--profile-features=screen_name,display_name,avatar",
  "--api=enable",
  "--action-cable=skip",
  "--mail=auto",
  "--deployment=dokploy"
].freeze
VARIANTS = {
  "devise-ja" => { authentication: "devise", locale: "ja", image_delivery: "rails" },
  "devise-en" => { authentication: "devise", locale: "en", image_delivery: "rails" },
  "siwe-ja" => { authentication: "wallet_siwe", report_authentication: "siwe", locale: "ja", image_delivery: "rails" },
  "siwe-en" => { authentication: "wallet_siwe", report_authentication: "siwe", locale: "en", image_delivery: "rails" },
  "imgproxy-devise-ja" => { authentication: "devise", locale: "ja", image_delivery: "imgproxy" }
}.freeze
IMGPROXY_ENVIRONMENT = {
  "IMGPROXY_ENDPOINT" => "http://localhost:8080",
  "IMGPROXY_KEY" => SecureRandom.hex(32),
  "IMGPROXY_SALT" => SecureRandom.hex(32),
  "IMGPROXY_SOURCE_ORIGIN" => "http://host.docker.internal:45678"
}.freeze

def run!(*command, env: {}, chdir: ROOT)
  puts "+ #{command.join(" ")}"
  success = system(env, *command, chdir: chdir)
  raise "コマンドが失敗しました: #{command.join(" ")}" unless success
end

def with_imgproxy
  container = "rapid-rails-imgproxy-evidence-#{Process.pid}"
  run!(
    "docker", "run", "--detach", "--rm", "--name", container,
    "--publish", "8080:8080",
    "--add-host", "host.docker.internal:host-gateway",
    "--env", "IMGPROXY_KEY=#{IMGPROXY_ENVIRONMENT.fetch("IMGPROXY_KEY")}",
    "--env", "IMGPROXY_SALT=#{IMGPROXY_ENVIRONMENT.fetch("IMGPROXY_SALT")}",
    "--env", "IMGPROXY_ALLOWED_SOURCES=#{IMGPROXY_ENVIRONMENT.fetch("IMGPROXY_SOURCE_ORIGIN")}/",
    "--env", "IMGPROXY_MAX_SRC_FILE_SIZE=5242880",
    "--env", "IMGPROXY_MAX_SRC_RESOLUTION=16.8",
    "--env", "IMGPROXY_MAX_ANIMATION_FRAMES=1",
    "darthsim/imgproxy:v4.0.12"
  )
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 30
  loop do
    response = Net::HTTP.get_response(URI("http://localhost:8080/health"))
    break if response.is_a?(Net::HTTPSuccess)
    raise "imgproxy health checkが時間内に成功しませんでした" if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep 0.5
  rescue EOFError, Errno::ECONNREFUSED, Errno::ECONNRESET, Net::OpenTimeout, Net::ReadTimeout
    raise "imgproxy health checkが時間内に成功しませんでした" if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep 0.5
  end
  yield
ensure
  system("docker", "stop", container) if container
end

run!(File.join(ROOT, "bin/build-bootstrap"))
run!(File.join(ROOT, "bin/verify-bootstrap"))
run!("docker", "info", "--format", "{{.ServerVersion}}") if VARIANTS.values.any? { |metadata| metadata.fetch(:image_delivery) == "imgproxy" }
source_fingerprint = RapidRailsTemplate::Evidence.fingerprint(ROOT)
base_commit, status = Open3.capture2("git", "rev-parse", "HEAD", chdir: ROOT)
raise "base commitを取得できません" unless status.success?

staging_root = Dir.mktmpdir(".evidence-", ROOT)
begin
  manifests = {}
  VARIANTS.each do |variant, metadata|
    FileUtils.rm_rf(SAMPLE)
    options = COMMON_OPTIONS + [
      "--account-authentication=#{metadata.fetch(:authentication)}",
      "--default-locale=#{metadata.fetch(:locale)}",
      "--image-delivery=#{metadata.fetch(:image_delivery)}",
      SAMPLE
    ]
    image_environment = metadata.fetch(:image_delivery) == "imgproxy" ? IMGPROXY_ENVIRONMENT : {}
    run!(RbConfig.ruby, File.join(ROOT, "bootstrap.rb"), *options, env: image_environment)
    run!(File.join(SAMPLE, "bin/rails"), "test", env: image_environment, chdir: SAMPLE)
    run!(File.join(SAMPLE, "bin/rubocop"), env: image_environment, chdir: SAMPLE)

    playwright = File.join(SAMPLE, "node_modules/.bin/playwright")
    raise "Playwright CLIが生成されていません: #{playwright}" unless File.executable?(playwright)
    run!(playwright, "install", "chromium", chdir: SAMPLE)

    output_directory = File.join(staging_root, variant)
    FileUtils.mkdir_p(output_directory)
    capture_environment = image_environment.merge(
        "RAILS_ENV" => "test",
        "EVIDENCE_OUTPUT_DIR" => output_directory,
        "PLAYWRIGHT_CLI_EXECUTABLE_PATH" => playwright
    )
    capture = lambda do
      run!(File.join(SAMPLE, "bin/rails"), "evidence:capture", env: capture_environment, chdir: SAMPLE)
    end
    metadata.fetch(:image_delivery) == "imgproxy" ? with_imgproxy(&capture) : capture.call
    manifests[variant] = RapidRailsTemplate::Evidence.finalize_variant(
      directory: output_directory,
      authentication: metadata.fetch(:report_authentication, metadata.fetch(:authentication)),
      locale: metadata.fetch(:locale),
      image_delivery: metadata.fetch(:image_delivery),
      source_fingerprint: source_fingerprint,
      base_commit: base_commit.strip
    )
  end

  RapidRailsTemplate::Evidence.write_index(staging_root, manifests)
  RapidRailsTemplate::Evidence.verify(root: ROOT, evidence_root: staging_root)

  backup = "#{DESTINATION}.backup-#{Process.pid}"
  FileUtils.rm_rf(backup)
  File.rename(DESTINATION, backup) if File.exist?(DESTINATION)
  begin
    File.rename(staging_root, DESTINATION)
    FileUtils.rm_rf(backup)
  rescue Exception
    File.rename(backup, DESTINATION) if File.exist?(backup) && !File.exist?(DESTINATION)
    raise
  end
ensure
  FileUtils.rm_rf(staging_root) if File.exist?(staging_root)
end

puts "UI evidence updated: #{DESTINATION}"
