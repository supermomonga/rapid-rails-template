<% content_for :page_title, t("billing.ui.cancel_subscription") %>
<%= render "billing/shared/breadcrumbs", label: "contract_details", path: account_subscription_path(@subscription), icon: "credit-card", current: t("billing.ui.cancel_subscription") %>
<%= render(Shadcn::Card.new) do %>
  <%= render(Shadcn::Card::Header.new) { render(Shadcn::Card::Title.new(tag: :h2)) { @subscription.plan_name } } %>
  <%= render(Shadcn::Card::Content.new(class: "space-y-3")) do %>
    <p><%= t("billing.ui.cancel_help") %></p>
    <p><%= t("billing.ui.paid_until") %>: <strong><%= @subscription.paid_until ? l(@subscription.paid_until, format: :long) : t("billing.ui.not_paid") %></strong></p>
    <%= form_with url: cancel_account_subscription_path(@subscription) do |form| %>
      <div class="flex flex-wrap justify-end gap-2"><%= link_to t("billing.ui.keep_subscription"), account_subscription_path(@subscription), class: action_button_classes(:quiet) %><%= form.submit t("billing.ui.confirm_cancellation"), class: action_button_classes(:destructive_confirm) %></div>
    <% end %>
  <% end %>
<% end %>
