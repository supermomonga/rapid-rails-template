<% content_for :page_title, @merchant.display_name %>
<%= render(Shadcn::Card.new) do %>
  <%= render(Shadcn::Card::Header.new) do %>
    <%= render(Shadcn::Card::Title.new(tag: :h2)) { billing_label("merchant_fee", "receipt-percent") } %>
    <%= render(Shadcn::Card::Description.new) { t("billing.ui.merchant_fee_help") } %>
  <% end %>
  <%= render(Shadcn::Card::Content.new) do %>
    <%= form_with model: @merchant, scope: :merchant_account, url: admin_merchant_path(@merchant) do |form| %>
      <%= render(Shadcn::Field.new) do %>
        <%= render(Shadcn::Field::Label.new(for: form.field_id(:fee_percent))) { t("billing.ui.fee_percent") } %>
        <%= render(Shadcn::InputGroup.new) do %>
          <%= form.text_field :fee_percent, value: @merchant.fee_basis_points.nil? ? "" : Billing::Amount.format(@merchant.fee_basis_points, decimals: 2), inputmode: "decimal", class: Shadcn::Input.classes(extra: Shadcn::InputGroup::Input.classes), data: { slot: "input-group-control" } %>
          <%= render(Shadcn::InputGroup::Addon.new(align: "inline-end")) do %>
            <%= render(Shadcn::InputGroup::Button.new(type: :submit, variant: :default)) { t("billing.ui.save") } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<div class="mt-6"><%= render "billing/shared/subscriptions", destination: "admin_subscription" %></div>
