<% content_for :page_title, t("billing.ui.chain_settings") %>
<div class="space-y-4">
  <% @chains.each do |chain| %>
    <% network = Billing::Chains.fetch(chain.chain_id) %>
    <%= render(Shadcn::Card.new) do %>
      <%= render(Shadcn::Card::Header.new) { render(Shadcn::Card::Title.new(tag: :h2)) { network.name } } %>
      <%= render(Shadcn::Card::Content.new(class: "space-y-4")) do %>
        <%= render "billing/shared/errors", errors: chain.errors.full_messages %>
        <p class="break-all"><%= t("billing.ui.collector") %>: <%= chain.collector_address.presence || t("billing.ui.not_created") %></p>
        <%= form_with scope: :chain, url: admin_chain_path(chain.chain_id), method: :patch do |form| %>
          <%= render(Shadcn::Field::Set.new) do %>
            <%= render(Shadcn::Field::Legend.new) { t("billing.ui.chain_settings") } %>
            <%= render(Shadcn::Field::Group.new) do %>
              <%= render(Shadcn::Field.new) do %>
                <%= render(Shadcn::Field::Label.new(for: "treasury_#{chain.chain_id}")) { t("billing.ui.treasury") } %>
                <%= form.text_field :treasury_address, value: @invalid_chain&.chain_id == chain.chain_id ? params.dig(:chain, :treasury_address) : chain.treasury_address, id: "treasury_#{chain.chain_id}", required: true, class: Shadcn::Input.classes, spellcheck: false %>
              <% end %>
              <%= render(Shadcn::Field.new) do %>
                <%= render(Shadcn::Field::Label.new(for: "gas_#{chain.chain_id}")) { t("billing.ui.gas_ceiling", symbol: network.native_symbol) } %>
                <%= render(Shadcn::InputGroup.new) do %>
                  <%= form.text_field :gas_ceiling_native, value: @invalid_chain&.chain_id == chain.chain_id ? params.dig(:chain, :gas_ceiling_native) : (chain.gas_ceiling_wei && Billing::Amount.format(chain.gas_ceiling_wei, decimals: 18)), id: "gas_#{chain.chain_id}", required: true, inputmode: "decimal", class: Shadcn::Input.classes(extra: Shadcn::InputGroup::Input.classes), data: { slot: "input-group-control" } %>
                  <%= render(Shadcn::InputGroup::Addon.new(align: "inline-end")) { form.submit t("billing.ui.save"), class: action_button_classes(:primary) } %>
                <% end %>
              <% end %>
            <% end %>
            <%= render(Shadcn::Field::Description.new) { t("billing.ui.gas_help") } %>
          <% end %>
        <% end %>
        <% unless chain.verified_at %>
          <%= form_with url: deploy_admin_chain_path(chain.chain_id), class: "space-y-3" do |form| %>
            <p><%= t("billing.ui.deploy_help") %></p>
            <%= render(Shadcn::Field.new(orientation: :horizontal)) do %>
              <%= render(Shadcn::Checkbox.new(id: "deploy_chain_#{chain.chain_id}_confirmed", name: "confirmed", value: "1", required: true)) %>
              <%= render(Shadcn::Field::Label.new(for: "deploy_chain_#{chain.chain_id}_confirmed")) { t("billing.ui.deploy_confirm", chain: network.name) } %>
            <% end %>
            <div class="flex flex-wrap justify-end gap-2"><%= form.submit t("billing.ui.deploy"), class: action_button_classes(:warning) %></div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
