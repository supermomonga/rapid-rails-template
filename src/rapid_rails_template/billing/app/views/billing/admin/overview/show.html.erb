<% content_for :page_title, t("billing.ui.overview") %>
<% content_for :page_actions_primary do %><%= link_to billing_label("chain_settings", "wallet"), admin_chain_settings_path, class: action_button_classes(:secondary) %><% end %>
<div class="space-y-6">
  <% if @missing_configuration.any? %>
    <%= render(Shadcn::Alert.new(variant: :destructive, role: "alert")) do %>
      <%= billing_icon("exclamation-triangle") %>
      <%= render(Shadcn::Alert::Title.new(tag: :h2)) { t("billing.ui.missing_configuration") } %>
      <%= render(Shadcn::Alert::Description.new) do %>
        <ul class="list-disc pl-5 break-all"><% @missing_configuration.each do |item| %><li><%= item %></li><% end %></ul>
      <% end %>
    <% end %>
  <% end %>
  <%= render(Shadcn::Card.new(class: "min-w-0")) do %>
    <%= render(Shadcn::Card::Header.new) do %>
      <%= render(Shadcn::Card::Title.new(tag: :h2)) { t("billing.ui.pending_transactions") } %>
      <%= render(Shadcn::Card::Description.new) { t("billing.ui.latest_100") } %>
    <% end %>
    <%= render(Shadcn::Card::Content.new) do %>
      <% if @transactions.empty? %><p><%= t("billing.ui.none") %></p><% end %>
      <%= render(Shadcn::Item::Group.new(tag: :ul)) do %>
        <% @transactions.each do |transaction| %>
          <%= render(Shadcn::Item.new(tag: :li, variant: :outline)) do %>
            <%= render(Shadcn::Item::Content.new(class: "min-w-0")) do %>
              <p><%= Billing::Chains.fetch(transaction.chain_setting.chain_id).name %> · <%= t("billing.kinds.#{transaction.kind}") %> · <%= t("billing.states.#{transaction.status}") %></p>
              <%= link_to t("billing.ui.transaction", id: transaction.id), transaction.explorer_url, class: "text-primary underline underline-offset-4", target: "_blank", rel: "noopener noreferrer" %>
              <% if transaction.error_code %><p class="break-words"><%= t("billing.transaction_errors.#{transaction.error_code}") %></p><% end %>
            <% end %>
            <% if transaction.status == "review" %><%= render(Shadcn::Item::Actions.new(class: "w-full justify-end")) { button_to t("billing.ui.recheck"), recheck_admin_transaction_path(transaction), class: action_button_classes(:warning) } %><% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= render(Shadcn::Card.new) do %>
    <%= render(Shadcn::Card::Header.new) do %>
      <%= render(Shadcn::Card::Title.new(tag: :h2)) { t("billing.ui.held_charges") } %>
      <%= render(Shadcn::Card::Description.new) { t("billing.ui.latest_100") } %>
    <% end %>
    <%= render(Shadcn::Card::Content.new) do %>
      <% if @held_charges.empty? %><p><%= t("billing.ui.none") %></p><% end %>
      <%= render(Shadcn::Item::Group.new(tag: :ul)) do %>
        <% @held_charges.each do |charge| %>
          <%= render(Shadcn::Item.new(tag: :li, variant: :outline)) { safe_join([link_to(t("billing.ui.charge", id: charge.id), admin_subscription_path(charge.subscription), class: "text-primary underline underline-offset-4"), " · #{charge.hold_reason}"]) } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
