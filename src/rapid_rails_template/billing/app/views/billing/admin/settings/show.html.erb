<% content_for :page_title, t("billing.ui.settings") %>
<%= render(Shadcn::Card.new) do %>
  <%= render(Shadcn::Card::Content.new(class: "space-y-4")) do %>
    <%= render "billing/shared/errors", errors: @settings.errors.full_messages %>
    <%= form_with model: @settings, scope: :setting, url: admin_settings_path, class: "space-y-6" do |form| %>
      <%= render(Shadcn::Field::Set.new) do %>
        <%= render(Shadcn::Field::Legend.new) { t("billing.ui.features") } %>
        <%= render(Shadcn::Field::Group.new) do %>
          <% %i[payments_enabled merchant_plan_creation_enabled admin_only].each do |attribute| %>
            <%= render(Shadcn::Field.new(orientation: :horizontal)) do %>
              <%= form.hidden_field attribute, value: "0", id: nil %>
              <%= render(Shadcn::Checkbox.new(id: form.field_id(attribute), name: form.field_name(attribute), value: "1", checked: @settings.public_send(attribute))) %>
              <%= render(Shadcn::Field::Label.new(for: form.field_id(attribute))) { t("billing.ui.#{attribute}") } %>
            <% end %>
          <% end %>
        <% end %>
        <%= render(Shadcn::Field::Description.new) { t("billing.ui.flags_help") } %>
      <% end %>
      <%= render(Shadcn::Field::Set.new) do %>
        <%= render(Shadcn::Field::Legend.new) { t("billing.ui.renewal_settings") } %>
        <%= render(Shadcn::Field::Group.new) do %>
          <%= render(Shadcn::Field.new) do %>
            <%= render(Shadcn::Field::Label.new(for: form.field_id(:fee_percent))) { t("billing.ui.fee_percent") } %>
            <%= form.text_field :fee_percent, value: params.dig(:setting, :fee_percent) || Billing::Amount.format(@settings.fee_basis_points, decimals: 2), required: true, inputmode: "decimal", class: Shadcn::Input.classes %>
          <% end %>
          <%= render(Shadcn::Field.new) do %>
            <%= render(Shadcn::Field::Label.new(for: form.field_id(:grace_hours))) { t("billing.ui.grace_hours") } %>
            <%= form.number_field :grace_hours, required: true, min: 0, class: Shadcn::Input.classes %>
          <% end %>
        <% end %>
        <%= render(Shadcn::Field::Description.new) { t("billing.ui.settings_help") } %>
      <% end %>
      <div class="flex flex-wrap justify-end gap-2"><%= form.submit t("billing.ui.save"), class: action_button_classes(:primary) %></div>
    <% end %>
  <% end %>
<% end %>
