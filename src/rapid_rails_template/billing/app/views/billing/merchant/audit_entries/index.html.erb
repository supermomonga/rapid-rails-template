<% content_for :page_title, t("billing.ui.audit_entries") %>
<%= render(Shadcn::Card.new) do %>
  <%= render(Shadcn::Card::Content.new(class: "space-y-4")) do %>
    <p><%= t("billing.ui.audit_help") %></p>
    <%= render(Shadcn::Item::Group.new(tag: :ul)) do %>
      <% @entries.each do |entry| %>
        <%= render(Shadcn::Item.new(tag: :li, variant: :outline)) do %>
          <%= render(Shadcn::Item::Media.new) { billing_icon("document-text") } %>
          <%= render(Shadcn::Item::Content.new(class: "min-w-0")) do %>
            <%= render(Shadcn::Item::Title.new(tag: :h2, class: "break-words")) { t("billing.ui.audit_actions.#{entry.action}") } %>
            <p class="break-words"><%= entry.actor_name %> · <%= l(entry.created_at, format: :long) %></p>
            <p><%= t("billing.ui.audit_targets.#{entry.target_type.demodulize.underscore}") %> #<%= entry.target_id %></p>
          <% end %>
          <dl class="grid w-full gap-3 sm:grid-cols-2">
            <% [["before_change", entry.before_values], ["after_change", entry.after_values]].each do |label, values| %>
              <div class="min-w-0"><dt class="font-semibold"><%= t("billing.ui.#{label}") %></dt><dd><ul class="space-y-1"><% values.each do |field, value| %><li class="break-words"><span class="text-muted-foreground"><%= t("billing.ui.audit_fields.#{field}") %>:</span> <%= billing_audit_value(field, value) %></li><% end %></ul></dd></div>
            <% end %>
          </dl>
        <% end %>
      <% end %>
    <% end %>
    <%= render "billing/shared/pagination" %>
  <% end %>
<% end %>
