<% content_for :page_title, t("billing.ui.merchant_area") %>
<% if Billing::MerchantAccess.eligible?(current_user) %>
  <% content_for :page_actions_primary do %><%= link_to billing_label("merchant_registration", "building-storefront"), new_merchant_account_path, class: action_button_classes(:primary) %><% end %>
  <%= render "billing/shared/empty", icon: "building-storefront", title: t("billing.ui.no_active_merchants"), description: t("billing.ui.no_active_merchants_help") %>
<% else %>
  <%= render(Shadcn::Alert.new) do %>
    <%= billing_icon("exclamation-triangle") %>
    <%= render(Shadcn::Alert::Description.new) { t("billing.ui.restricted_help") } %>
  <% end %>
<% end %>
<%= render(Shadcn::Card.new(class: "mt-6")) do %>
  <%= render(Shadcn::Card::Header.new) do %>
    <%= render(Shadcn::Card::Title.new(tag: :h2)) { billing_label("invitations", "clock") } %>
    <%= render(Shadcn::Card::Description.new) { t("billing.ui.invitation_help") } %>
  <% end %>
  <%= render(Shadcn::Card::Footer.new(class: "justify-end")) { link_to billing_label("invitations", "clock"), merchant_invitations_path, class: action_button_classes(:secondary) } %>
<% end %>
<% if @closed_merchants.any? %>
  <%= render(Shadcn::Card.new(class: "mt-6")) do %>
    <%= render(Shadcn::Card::Header.new) { render(Shadcn::Card::Title.new(tag: :h2)) { t("billing.ui.closed_merchants") } } %>
    <%= render(Shadcn::Card::Content.new) do %>
      <ul class="divide-y"><% @closed_merchants.each do |merchant| %>
        <li class="flex items-center gap-3 py-2"><%= billing_icon("building-storefront") %><%= link_to merchant.display_name, merchant_dashboard_path(merchant_id: merchant.public_id), class: "min-w-0 break-words text-primary underline underline-offset-4" %></li>
      <% end %></ul>
    <% end %>
  <% end %>
<% end %>
