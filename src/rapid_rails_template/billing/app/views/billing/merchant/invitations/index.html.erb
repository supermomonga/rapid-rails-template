<% content_for :page_title, t("billing.ui.invitations") %>
<% unless Billing::MerchantAccess.eligible?(current_user) %><div class="alert alert-info alert-soft mb-4"><%= billing_icon("exclamation-triangle") %><span><%= t("billing.ui.restricted_help") %></span></div><% end %>
<section class="card card-border bg-base-100"><div class="card-body p-3">
  <p><%= t("billing.ui.invitation_help") %></p>
  <% if @invitations.empty? %><p><%= t("billing.ui.no_invitations") %></p><% end %>
  <ul class="list"><% @invitations.each do |invitation| %>
    <% expired = invitation.status == "pending" && Time.current >= invitation.expires_at %>
    <li class="list-row"><%= billing_icon("building-storefront") %><div class="list-col-grow min-w-0"><h2 class="font-semibold break-words"><%= invitation.merchant_account.display_name %></h2><p><%= t("billing.ui.member_roles.#{invitation.role}") %></p><p><%= t("billing.ui.expires_at", at: l(invitation.expires_at, format: :long)) %></p><span class="badge"><%= t("billing.ui.invitation_states.#{expired ? 'expired' : invitation.status}") %></span></div>
      <% if invitation.status == "pending" %>
        <div class="list-col-wrap flex flex-wrap justify-end gap-2">
          <%= button_to t("billing.ui.reject_invitation"), reject_merchant_invitation_path(invitation), class: action_button_classes(:quiet) %>
          <%= button_to t("billing.ui.accept_invitation"), accept_merchant_invitation_path(invitation), class: action_button_classes(:primary) if !expired && Billing::MerchantAccess.eligible?(current_user) && invitation.merchant_account.status != "closed" %>
        </div>
      <% end %>
    </li>
  <% end %></ul>
  <%= render "billing/shared/pagination" %>
</div></section>
