<% content_for :page_title, t("billing.ui.invitations") %>
<% unless Billing::MerchantAccess.eligible?(current_user) %>
  <%= render(Shadcn::Alert.new(class: "mb-4")) do %>
    <%= billing_icon("exclamation-triangle") %>
    <%= render(Shadcn::Alert::Description.new) { t("billing.ui.restricted_help") } %>
  <% end %>
<% end %>
<%= render(Shadcn::Card.new) do %>
  <%= render(Shadcn::Card::Content.new(class: "space-y-4")) do %>
    <p><%= t("billing.ui.invitation_help") %></p>
    <% if @invitations.empty? %><p><%= t("billing.ui.no_invitations") %></p><% end %>
    <%= render(Shadcn::Item::Group.new(tag: :ul)) do %>
      <% @invitations.each do |invitation| %>
        <% expired = invitation.status == "pending" && Time.current >= invitation.expires_at %>
        <%= render(Shadcn::Item.new(tag: :li, variant: :outline)) do %>
          <%= render(Shadcn::Item::Media.new) { billing_icon("building-storefront") } %>
          <%= render(Shadcn::Item::Content.new(class: "min-w-0")) do %>
            <%= render(Shadcn::Item::Title.new(tag: :h2, class: "break-words")) { invitation.merchant_account.display_name } %>
            <p><%= t("billing.ui.member_roles.#{invitation.role}") %></p>
            <p><%= t("billing.ui.expires_at", at: l(invitation.expires_at, format: :long)) %></p>
            <%= render(Shadcn::Badge.new(variant: :outline)) { t("billing.ui.invitation_states.#{expired ? 'expired' : invitation.status}") } %>
          <% end %>
          <% if invitation.status == "pending" %>
            <%= render(Shadcn::Item::Actions.new(class: "w-full flex-wrap justify-end")) do %>
              <%= button_to t("billing.ui.reject_invitation"), reject_merchant_invitation_path(invitation), class: action_button_classes(:quiet) %>
              <%= button_to t("billing.ui.accept_invitation"), accept_merchant_invitation_path(invitation), class: action_button_classes(:primary) if !expired && Billing::MerchantAccess.eligible?(current_user) && invitation.merchant_account.status != "closed" %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= render "billing/shared/pagination" %>
  <% end %>
<% end %>
