<% content_for :page_title, t("billing.ui.members") %>
<%= render(Shadcn::Card.new) do %>
  <%= render(Shadcn::Card::Header.new) do %>
    <%= render(Shadcn::Card::Title.new(tag: :h2)) { billing_label("members", "user-circle") } %>
    <%= render(Shadcn::Card::Description.new) { t("billing.ui.member_roles_help") } %>
  <% end %>
  <%= render(Shadcn::Card::Content.new(class: "space-y-4")) do %>
    <%= render(Shadcn::Item::Group.new(tag: :ul)) do %>
      <% @memberships.each do |membership| %>
        <%= render(Shadcn::Item.new(tag: :li, variant: :outline)) do %>
          <%= render(Shadcn::Item::Media.new) { billing_icon("user-circle") } %>
          <%= render(Shadcn::Item::Content.new(class: "min-w-0")) do %>
            <%= render(Shadcn::Item::Title.new(tag: :h3, class: "break-words")) { membership.user.profile.display_name } %>
            <p class="break-all">@<%= membership.user.profile.screen_name %></p>
            <%= render(Shadcn::Badge.new(variant: :outline)) { t("billing.ui.member_roles.#{membership.role}") } %>
          <% end %>
          <div class="w-full space-y-3">
            <% if merchant_manageable? %>
              <%= form_with model: membership, scope: :merchant_membership, url: merchant_membership_path(membership) do |form| %>
                <%= render(Shadcn::Field.new) do %>
                  <%= render(Shadcn::Field::Label.new(for: "membership_role_#{membership.id}")) { t("billing.ui.role_for", name: membership.user.profile.display_name) } %>
                  <div class="flex flex-wrap gap-2">
                    <%= render(Shadcn::NativeSelect.new(id: "membership_role_#{membership.id}", name: form.field_name(:role), class: "min-w-0 flex-1")) do %>
                      <% Billing::MerchantMembership::ROLES.each do |role| %><%= render(Shadcn::NativeSelect::Option.new(value: role, selected: membership.role == role)) { t("billing.ui.member_roles.#{role}") } %><% end %>
                    <% end %>
                    <%= form.submit t("common.update"), class: action_button_classes(:primary), aria: { label: t("billing.ui.change_role") } %>
                  </div>
                <% end %>
              <% end %>
            <% end %>
            <% if merchant_manageable? || membership.user_id == current_user.id %>
              <div class="flex flex-wrap justify-end gap-2"><%= button_to t(membership.user_id == current_user.id ? "billing.ui.leave_merchant" : "billing.ui.remove_member"), merchant_membership_path(membership), method: :delete, class: action_button_classes(:destructive), form: { data: { turbo_confirm: t("billing.ui.remove_member_confirmation", name: membership.user.profile.display_name, merchant: merchant_account.display_name) } } %></div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
    <%= render "billing/shared/pagination" %>
  <% end %>
<% end %>
<% if merchant_manageable? %>
  <%= render(Shadcn::Card.new(class: "mt-6")) do %>
    <%= render(Shadcn::Card::Header.new) do %>
      <%= render(Shadcn::Card::Title.new(tag: :h2)) { billing_label("invite_member", "user-circle") } %>
      <%= render(Shadcn::Card::Description.new) { t("billing.ui.invitation_help") } %>
    <% end %>
    <%= render(Shadcn::Card::Content.new(class: "space-y-4")) do %>
      <%= form_with url: merchant_member_invitations_path, scope: :invitation do |form| %>
        <%= render(Shadcn::Field::Group.new) do %>
          <%= render(Shadcn::Field.new) do %>
            <%= render(Shadcn::Field::Label.new(for: form.field_id(:screen_name))) { t("billing.ui.screen_name") } %>
            <%= form.text_field :screen_name, required: true, class: Shadcn::Input.classes, spellcheck: false, autocomplete: "off" %>
          <% end %>
          <%= render(Shadcn::Field.new) do %>
            <%= render(Shadcn::Field::Label.new(for: form.field_id(:role))) { t("billing.ui.role") } %>
            <div class="flex flex-wrap gap-2">
              <%= render(Shadcn::NativeSelect.new(id: form.field_id(:role), name: form.field_name(:role), class: "min-w-0 flex-1")) do %>
                <% Billing::MerchantMembership::ROLES.each do |role| %><%= render(Shadcn::NativeSelect::Option.new(value: role, selected: role == "viewer")) { t("billing.ui.member_roles.#{role}") } %><% end %>
              <% end %>
              <%= form.submit t("billing.ui.invite"), class: action_button_classes(:primary), aria: { label: t("billing.ui.invite_member") } %>
            </div>
          <% end %>
        <% end %>
      <% end %>
      <%= render(Shadcn::Item::Group.new(tag: :ul)) do %>
        <% @invitations.each do |invitation| %>
          <%= render(Shadcn::Item.new(tag: :li, variant: :outline)) do %>
            <%= render(Shadcn::Item::Media.new) { billing_icon("clock") } %>
            <%= render(Shadcn::Item::Content.new(class: "min-w-0")) do %>
              <p class="break-words"><%= invitation.recipient&.profile&.display_name %> · <%= t("billing.ui.member_roles.#{invitation.role}") %></p>
              <p><%= t("billing.ui.expires_at", at: l(invitation.expires_at, format: :long)) %></p>
            <% end %>
            <%= render(Shadcn::Item::Actions.new(class: "w-full flex-wrap justify-end")) { button_to t("billing.ui.revoke_invitation"), merchant_member_invitation_path(invitation), method: :delete, class: action_button_classes(:destructive) } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
