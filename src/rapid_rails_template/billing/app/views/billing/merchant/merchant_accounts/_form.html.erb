<%= render "billing/shared/errors", errors: @merchant.errors.full_messages %>
<%= form_with model: @merchant, scope: :merchant_account, url: @merchant.persisted? ? merchant_profile_path : merchant_accounts_path do |form| %>
  <%= render(Shadcn::Field::Set.new(disabled: @merchant.persisted? && !merchant_editable?)) do %>
    <%= render(Shadcn::Field::Legend.new) { t("billing.ui.merchant_profile") } %>
    <%= render(Shadcn::Field::Description.new) { t("billing.ui.merchant_profile_help") } %>
    <%= render(Shadcn::Field::Group.new) do %>
      <%= render(Shadcn::Field.new) do %>
        <%= render(Shadcn::Field::Label.new(for: form.field_id(:public_id))) { t("billing.ui.public_id") } %>
        <%= form.text_field :public_id, required: true, class: Shadcn::Input.classes, spellcheck: false, autocomplete: "off", aria: { describedby: "merchant-public-id-help" } %>
        <%= render(Shadcn::Field::Description.new(id: "merchant-public-id-help")) { t("billing.ui.public_id_help") } %>
      <% end %>
      <%= render(Shadcn::Field.new) do %>
        <%= render(Shadcn::Field::Label.new(for: form.field_id(:display_name))) { t("billing.ui.display_name") } %>
        <%= form.text_field :display_name, required: true, maxlength: 100, class: Shadcn::Input.classes %>
      <% end %>
      <%= render(Shadcn::Field.new) do %>
        <%= render(Shadcn::Field::Label.new(for: form.field_id(:introduction))) { t("billing.ui.introduction") } %>
        <%= form.text_area :introduction, rows: 4, maxlength: 5000, class: Shadcn::Textarea.classes %>
      <% end %>
      <%= render(Shadcn::Field.new) do %>
        <%= render(Shadcn::Field::Label.new(for: form.field_id(:image_upload))) { t("billing.ui.image") } %>
        <% if @merchant.image.attached? %><%= render(Shadcn::Avatar.new(class: "size-20 self-start")) { render(Shadcn::Avatar::Image.new(src: main_app.rails_storage_proxy_path(@merchant.image), width: 80, height: 80, alt: @merchant.display_name)) } %><% end %>
        <%= form.file_field :image_upload, accept: "image/png,image/jpeg,image/webp", class: Shadcn::Input.classes, aria: { describedby: "merchant-image-help" } %>
        <%= render(Shadcn::Field::Description.new(id: "merchant-image-help")) { t("billing.ui.image_help") } %>
      <% end %>
    <% end %>
    <% if !@merchant.persisted? || merchant_editable? %><div class="flex flex-wrap justify-end gap-2"><%= form.submit t("billing.ui.save"), class: action_button_classes(:primary) %></div><% end %>
  <% end %>
<% end %>
