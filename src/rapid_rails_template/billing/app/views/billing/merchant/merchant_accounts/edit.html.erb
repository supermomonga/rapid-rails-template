<% content_for :page_title, t("billing.ui.merchant_settings") %>
<% content_for :page_actions_primary do %><%= link_to billing_label("public_page", "arrow-top-right-on-square"), Billing::Engine.routes.url_helpers.merchant_path(@merchant.public_id), class: action_button_classes(:secondary) %><% end %>
<%= with_tab tabs: billing_tabs(:merchant_settings), aria_label: t("billing.ui.merchant_settings") do %><%= render "form" %><% end %>
<% if merchant_manageable? && @merchant.status == "active" %>
  <%= render(Shadcn::Card.new(class: "mt-6")) do %>
    <%= render(Shadcn::Card::Header.new) do %>
      <%= render(Shadcn::Card::Title.new(tag: :h2)) { billing_label("close_merchant", "exclamation-triangle") } %>
      <%= render(Shadcn::Card::Description.new) { t("billing.ui.closure_help") } %>
    <% end %>
    <%= render(Shadcn::Card::Footer.new(class: "justify-end")) { link_to t("billing.ui.close_merchant"), merchant_closure_path, class: action_button_classes(:destructive) } %>
  <% end %>
<% end %>
