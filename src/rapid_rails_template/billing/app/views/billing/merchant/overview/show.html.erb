<% content_for :page_title, t("billing.ui.merchant_area") %>
<% content_for :page_actions_primary do %><%= link_to billing_label("new_plan", "squares-2x2"), new_merchant_plan_path, class: action_button_classes(:primary) if merchant_editable? && @merchant.status == "active" && Billing::Setting.current.merchant_plan_creation_enabled? %><% end %>
<% content_for :page_actions_secondary do %><%= link_to billing_label("public_page", "arrow-top-right-on-square"), Billing::Engine.routes.url_helpers.merchant_path(@merchant.public_id), class: action_button_classes(:secondary) %><% end %>
<div class="space-y-6">
  <p class="text-muted-foreground"><%= t("billing.ui.revenue_scope") %></p>
  <div class="grid gap-4 sm:grid-cols-2">
    <% [["gross_sales", @gross_units, "banknotes"], ["operator_fee", @fee_units, "receipt-percent"], ["merchant_received", @net_units, "wallet"], ["manual_refund_total", @refund_units, "arrow-uturn-left"]].each do |label, units, icon| %>
      <%= render(Shadcn::Card.new(class: "min-w-0")) do %>
        <%= render(Shadcn::Card::Header.new) { render(Shadcn::Card::Title.new(tag: :h3)) { t("billing.ui.#{label}") } } %>
        <%= render(Shadcn::Card::Content.new) do %>
          <p class="break-all text-2xl font-semibold tabular-nums" data-billing-summary-amount="<%= label %>" data-billing-amount><%= billing_amount(units) %> <span class="text-sm">USDC</span></p>
        <% end %>
        <%= render(Shadcn::Card::Footer.new) { link_to billing_label("view_history", icon), label == "manual_refund_total" ? merchant_refund_records_path : merchant_payments_path, class: "text-primary underline underline-offset-4" } %>
      <% end %>
    <% end %>
  </div>
  <%= render(Shadcn::Card.new) do %>
    <%= render(Shadcn::Card::Header.new) { render(Shadcn::Card::Title.new(tag: :h3)) { billing_label("next_actions", "document-text") } } %>
    <%= render(Shadcn::Card::Content.new) do %>
      <ul class="divide-y">
        <li class="flex items-start gap-3 py-3"><%= billing_icon("credit-card") %><%= link_to t("billing.ui.open_contracts", count: @open_count), merchant_sales_path, class: "min-w-0 text-primary underline underline-offset-4" %></li>
        <li class="flex items-start gap-3 py-3"><%= billing_icon("clock") %><div class="min-w-0"><%= link_to t("billing.ui.held_count", count: @held_count), merchant_payments_path, class: "text-primary underline underline-offset-4" %><p class="text-muted-foreground"><%= t("billing.ui.held_help") %></p></div></li>
        <% if merchant_manageable? && @missing_payouts.any? %><li class="flex items-start gap-3 py-3"><%= billing_icon("exclamation-triangle") %><div class="min-w-0"><%= link_to t("billing.ui.complete_payouts"), merchant_payout_addresses_path, class: "text-primary underline underline-offset-4" %><p class="break-words"><%= @missing_payouts.map { |id| Billing::Chains.fetch(id).name }.join(" / ") %></p></div></li><% end %>
      </ul>
    <% end %>
  <% end %>
</div>
