<% content_for :page_title, t("billing.ui.merchant_settings") %>
<%= with_tab tabs: billing_tabs(:merchant_settings), aria_label: t("billing.ui.merchant_settings") do %>
  <p class="mb-4"><%= t("billing.ui.payout_help") %></p>
  <div class="grid gap-4 xl:grid-cols-2">
    <% Billing::Chains::ALL.each_value do |chain| %>
      <% payout = @invalid_payout&.chain_id == chain.id ? @invalid_payout : (@merchant.payout_addresses.find_by(chain_id: chain.id) || @merchant.payout_addresses.new(chain_id: chain.id)) %>
      <%= render(Shadcn::Card.new) do %>
        <%= render(Shadcn::Card::Header.new) do %>
          <%= render(Shadcn::Card::Title.new(tag: :h2)) { chain.name } %>
          <%= render(Shadcn::Badge.new(variant: payout.persisted? ? :secondary : :outline)) { t(payout.persisted? ? "billing.ui.configured" : "billing.ui.not_configured") } %>
        <% end %>
        <%= render(Shadcn::Card::Content.new(class: "space-y-4")) do %>
          <%= render "billing/shared/errors", errors: payout.errors.full_messages %>
          <%= form_with model: payout, scope: :payout_address, url: payout.persisted? ? merchant_payout_address_path(payout) : merchant_payout_addresses_path do |form| %>
            <%= render(Shadcn::Field::Set.new(disabled: !merchant_manageable?)) do %>
              <%= render(Shadcn::Field::Legend.new) { t("billing.ui.payout_address") } %>
              <%= form.hidden_field :chain_id %>
              <%= render(Shadcn::Field.new) do %>
                <%= render(Shadcn::Field::Label.new(for: "payout_#{chain.id}")) { t("billing.ui.payout_address_for", chain: chain.name) } %>
                <%= render(Shadcn::InputGroup.new) do %>
                  <%= form.text_field :address, id: "payout_#{chain.id}", required: true, class: Shadcn::Input.classes(extra: Shadcn::InputGroup::Input.classes), data: { slot: "input-group-control" }, spellcheck: false, autocomplete: "off", aria: { invalid: payout.errors[:address].any? } %>
                  <% if merchant_manageable? %>
                    <%= render(Shadcn::InputGroup::Addon.new(align: "inline-end")) do %>
                      <%= render(Shadcn::InputGroup::Button.new(type: :submit, variant: :default, aria: { label: t("billing.ui.save_chain", chain: chain.name) })) { t("billing.ui.save") } %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
