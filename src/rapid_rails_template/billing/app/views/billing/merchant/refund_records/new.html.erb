<% content_for :page_title, t("billing.ui.manual_refund") %>
<%= render "billing/shared/breadcrumbs", label: "payments", path: merchant_sale_path(@charge.subscription, tab: "payments"), icon: "banknotes", current: t("billing.ui.manual_refund") %>
<%= render(Shadcn::Card.new) do %>
  <%= render(Shadcn::Card::Header.new) { render(Shadcn::Card::Title.new(tag: :h2)) { @charge.subscription.plan_name } } %>
  <%= render(Shadcn::Card::Content.new(class: "space-y-3")) do %>
    <p><%= t("billing.ui.charge", id: @charge.id) %> · <%= billing_amount(@charge.amount_units) %> USDC</p>
    <%= render "billing/shared/refund_form", charge: @charge, area: "merchant", back: merchant_sale_path(@charge.subscription, tab: "payments") %>
  <% end %>
<% end %>
