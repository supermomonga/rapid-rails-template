<div class="flex items-center gap-4">
  <% if merchant.image.attached? %>
    <%= render(Shadcn::Avatar.new(class: "size-20")) { render(Shadcn::Avatar::Image.new(src: main_app.url_for(merchant.image), width: 80, height: 80, alt: merchant.display_name)) } %>
  <% else %><%= billing_icon("building-storefront") %><% end %>
  <h2 class="text-xl font-semibold break-words"><%= merchant.display_name %></h2>
</div>
<p class="mt-3 whitespace-pre-wrap break-words text-muted-foreground"><%= merchant.introduction %></p>
