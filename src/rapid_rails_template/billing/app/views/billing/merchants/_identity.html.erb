<div class="flex items-center gap-4">
  <% if merchant.image.attached? %><div class="avatar"><div class="w-20 rounded-full"><%= image_tag main_app.url_for(merchant.image), width: 80, height: 80, alt: merchant.display_name %></div></div><% else %><%= billing_icon("building-storefront") %><% end %>
  <h2 class="text-xl font-semibold break-words"><%= merchant.display_name %></h2>
</div>
<p class="mt-3 whitespace-pre-wrap break-words text-base-content/70"><%= merchant.introduction %></p>
