<% content_for :page_title, t("billing.ui.merchants") %>
<%= render layout: "layouts/billing/public" do %>
  <% if @merchants.empty? %><%= render "billing/shared/empty", icon: "building-storefront", title: t("billing.ui.no_merchants"), description: t("billing.ui.no_merchants_help") %><% end %>
  <div class="grid gap-4 sm:grid-cols-2">
    <% @merchants.each do |merchant| %>
      <%= render(Shadcn::Card.new) do %>
        <%= render(Shadcn::Card::Content.new) { render "billing/merchants/identity", merchant: merchant } %>
        <%= render(Shadcn::Card::Footer.new(class: "justify-end")) { link_to t("billing.ui.details"), merchant_path(merchant.public_id), class: action_button_classes(:secondary) } %>
      <% end %>
    <% end %>
  </div>
  <%= render "billing/shared/pagination" %>
<% end %>
