<% contract = local_assigns[:subscription] %>
<%= tag.div data: { controller: "billing-checkout", billing_checkout_create_url_value: account_subscriptions_path, billing_checkout_plan_id_value: plan.id, billing_checkout_app_name_value: application_identity.app_name, billing_checkout_labels_value: t("billing.checkout"), billing_checkout_contract_value: contract && { typed_data: Billing::Checkout.typed_data(contract), authorize_path: authorize_account_subscription_path(contract), subscription_path: account_subscription_path(contract), review: Billing::Checkout.review(contract) } } do %>
  <%= render(Shadcn::Alert.new(variant: :destructive, role: "alert", hidden: true, data: { billing_checkout_target: "error" })) do %>
    <%= billing_icon("exclamation-triangle") %>
    <%= render(Shadcn::Alert::Title.new) { t("billing.checkout.error_title") } %>
    <%= render(Shadcn::Alert::Description.new) { tag.span(data: { billing_checkout_target: "errorMessage" }) } %>
  <% end %>
  <%= render(Shadcn::Field::Set.new) do %>
    <%= render(Shadcn::Field::Legend.new) { t("billing.ui.payment_wallet") } %>
    <%= render(Shadcn::Field::Description.new) { t("billing.ui.wallet_help") } %>
    <%= render(Shadcn::Field.new) do %>
      <%= render(Shadcn::Field::Label.new(for: "billing_chain")) { t("billing.ui.chain") } %>
      <%= render(Shadcn::NativeSelect.new(id: "billing_chain", name: "billing_chain", class: "w-full", data: { billing_checkout_target: "chain" })) do %>
        <% chain_ids.each do |id| %><%= render(Shadcn::NativeSelect::Option.new(value: id)) { Billing::Chains.fetch(id).name } %><% end %>
      <% end %>
    <% end %>
  <% end %>
  <div class="flex flex-wrap justify-end gap-2">
    <%= button_tag t("billing.ui.connect_wallet"), type: :button, class: action_button_classes(:primary), data: { action: "billing-checkout#prepare", billing_checkout_target: "prepare" } %>
  </div>
  <div hidden data-billing-checkout-target="review" class="space-y-3">
    <p class="whitespace-pre-wrap break-all" data-billing-checkout-target="terms"></p>
    <p><%= t("billing.ui.checkout_terms") %></p>
    <div class="flex flex-wrap justify-end gap-2"><%= button_tag t("billing.ui.authorize_payment"), type: :button, class: action_button_classes(:primary), data: { action: "billing-checkout#authorize", billing_checkout_target: "authorize" } %></div>
  </div>
  <p role="status" aria-live="polite" class="mt-3 break-words" data-billing-checkout-target="message"></p>
  <a hidden class="text-primary underline underline-offset-4" data-billing-checkout-target="contractLink"><%= t("billing.ui.saved_contract") %></a>
<% end %>
