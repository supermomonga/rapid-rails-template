<%= render(Shadcn::Empty.new(data: { billing_empty: true })) do %>
  <%= render(Shadcn::Empty::Header.new) do %>
    <%= render(Shadcn::Empty::Media.new(variant: :icon)) { billing_icon(icon) } %>
    <%= render(Shadcn::Empty::Title.new) { title } %>
    <%= render(Shadcn::Empty::Description.new) { description } %>
  <% end %>
  <% if local_assigns[:path] %><%= render(Shadcn::Empty::Content.new) { link_to label, path, class: action_button_classes(:secondary) } %><% end %>
<% end %>
