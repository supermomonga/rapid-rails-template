<%= form_with url: request.path, method: :get, class: "grid gap-3" do |form| %>
  <div class="min-w-0">
    <%= form.label :chain_id, t("billing.ui.chain"), class: "label" %>
    <div class="<%= class_names('join w-full' => !local_assigns[:statuses]) %>">
      <%= form.select :chain_id, Billing::Chains::ALL.values.map { |chain| [chain.name, chain.id] }, { include_blank: t("billing.ui.all_chains"), selected: params[:chain_id] }, class: class_names('select', local_assigns[:statuses] ? 'w-full' : 'join-item min-w-0 flex-1') %>
      <% unless local_assigns[:statuses] %><%= form.submit t("billing.ui.apply"), class: class_names(action_button_classes(:secondary), "join-item"), aria: { label: t("billing.ui.apply_filters") } %><% end %>
    </div>
  </div>
  <% if local_assigns[:statuses] %>
    <div class="min-w-0">
      <%= form.label :status, t("billing.ui.status"), class: "label" %>
      <div class="join w-full">
        <%= form.select :status, statuses.map { |state| [t("billing.states.#{state}"), state] }, { include_blank: t("billing.ui.all_states"), selected: params[:status] }, class: "select join-item min-w-0 flex-1" %>
        <%= form.submit t("billing.ui.apply"), class: class_names(action_button_classes(:secondary), "join-item"), aria: { label: t("billing.ui.apply_filters") } %>
      </div>
    </div>
  <% end %>
  <div class="flex flex-wrap justify-end gap-2"><%= link_to t("billing.ui.reset_filters"), request.path, class: action_button_classes(:quiet) %></div>
<% end %>
