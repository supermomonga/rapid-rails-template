<%= form_with url: request.path, method: :get, class: "grid gap-3" do |form| %>
  <%= render(Shadcn::Field.new) do %>
    <%= render(Shadcn::Field::Label.new(for: form.field_id(:chain_id))) { t("billing.ui.chain") } %>
    <div class="flex min-w-0 flex-wrap gap-2">
      <%= render(Shadcn::NativeSelect.new(id: form.field_id(:chain_id), name: form.field_name(:chain_id), class: "min-w-0 flex-1")) do %>
        <%= render(Shadcn::NativeSelect::Option.new(value: "", selected: params[:chain_id].blank?)) { t("billing.ui.all_chains") } %>
        <% Billing::Chains::ALL.each_value do |chain| %><%= render(Shadcn::NativeSelect::Option.new(value: chain.id, selected: params[:chain_id].to_s == chain.id.to_s)) { chain.name } %><% end %>
      <% end %>
      <% unless local_assigns[:statuses] %><%= form.submit t("billing.ui.apply"), class: action_button_classes(:secondary), aria: { label: t("billing.ui.apply_filters") } %><% end %>
    </div>
  <% end %>
  <% if local_assigns[:statuses] %>
    <%= render(Shadcn::Field.new) do %>
      <%= render(Shadcn::Field::Label.new(for: form.field_id(:status))) { t("billing.ui.status") } %>
      <div class="flex min-w-0 flex-wrap gap-2">
        <%= render(Shadcn::NativeSelect.new(id: form.field_id(:status), name: form.field_name(:status), class: "min-w-0 flex-1")) do %>
          <%= render(Shadcn::NativeSelect::Option.new(value: "", selected: params[:status].blank?)) { t("billing.ui.all_states") } %>
          <% statuses.each do |state| %><%= render(Shadcn::NativeSelect::Option.new(value: state, selected: params[:status] == state)) { t("billing.states.#{state}") } %><% end %>
        <% end %>
        <%= form.submit t("billing.ui.apply"), class: action_button_classes(:secondary), aria: { label: t("billing.ui.apply_filters") } %>
      </div>
    <% end %>
  <% end %>
  <div class="flex flex-wrap justify-end gap-2"><%= link_to t("billing.ui.reset_filters"), request.path, class: action_button_classes(:quiet) %></div>
<% end %>
