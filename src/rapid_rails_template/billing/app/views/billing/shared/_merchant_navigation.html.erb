<% routes = Billing::Engine.routes.url_helpers %>
<% if current_user.merchant_profile&.persisted? %>
  <%= billing_menu_item("merchant_overview", routes.merchant_root_path, "home", active: controller_path == "billing/merchant/overview") %>
  <%= billing_menu_item("seller_plans", routes.merchant_plans_path, "squares-2x2", active: controller_path == "billing/merchant/plans") %>
  <%= billing_menu_item("sales", routes.merchant_sales_path, "banknotes", active: controller_path.in?(%w[billing/merchant/sales billing/merchant/payments billing/merchant/refund_records])) %>
  <%= billing_menu_item("merchant_settings", routes.edit_merchant_profile_path, "cog-6-tooth", active: controller_path.in?(%w[billing/merchant/merchant_profiles billing/merchant/payout_addresses])) %>
  <%= billing_menu_item("public_page", routes.merchant_path(current_user.merchant_profile.public_id), "arrow-top-right-on-square", active: false) %>
<% else %>
  <%= billing_menu_item("merchant_registration", routes.new_merchant_profile_path, "building-storefront", active: true) %>
<% end %>
<%= billing_menu_item("back_account", application_routes.account_path, "arrow-uturn-left", active: false) %>
