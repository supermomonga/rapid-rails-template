<% accounts = Billing::MerchantAccess.accounts(current_user).order(updated_at: :desc, id: :desc).to_a %>
<% current_account = accounts.find { |account| account.public_id == params[:merchant_id] } %>
<% if accounts.any? %>
  <%= render(Shadcn::Card.new(class: "mt-4", aria: { labelledby: "billing-merchant-context" }, data: { billing_merchant_selector: true })) do %>
    <%= render(Shadcn::Card::Content.new) do %>
      <h2 id="billing-merchant-context" class="text-sm font-semibold"><%= t(current_account ? "billing.ui.current_merchant" : "billing.ui.select_merchant") %></h2>
      <% if current_account %>
        <p class="font-semibold [overflow-wrap:anywhere]" data-billing-current-merchant><%= current_account.display_name %></p>
        <%= render(Shadcn::Badge.new(variant: :outline)) { t("billing.ui.business_states.#{current_account.status}") } %>
      <% end %>
      <% if current_account.nil? || accounts.many? %>
        <%= render(Shadcn::DropdownMenu.new(class: "w-full")) do %>
          <%= render(Shadcn::DropdownMenu::Trigger.new(variant: :secondary, class: "mt-3 w-full")) do %>
            <%= t(current_account ? "billing.ui.switch_merchant" : (accounts.all? { |account| account.status == "closed" } ? "billing.ui.open_merchant_history" : "billing.ui.select_merchant")) %>
            <%= billing_icon("chevron-down") %>
          <% end %>
          <%= render(Shadcn::DropdownMenu::Content.new(id: "billing-merchant-choices", align: :end, class: "max-h-80 w-80 max-w-[calc(100vw-2.5rem)] overflow-y-auto", aria: { label: t("billing.ui.select_merchant") })) do %>
            <%= form_with url: Billing::Engine.routes.url_helpers.merchant_selection_path do %>
              <% accounts.each do |account| %>
                <% if account == current_account %>
                  <%= render(Shadcn::DropdownMenu::Label.new(class: "flex items-start gap-2 whitespace-normal [overflow-wrap:anywhere]", aria: { current: true })) do %>
                    <%= billing_icon("check-circle") %>
                    <span class="min-w-0">
                      <span class="block font-semibold"><%= account.display_name %></span>
                      <span class="block"><%= t("billing.ui.business_states.#{account.status}") %> · <%= t("billing.ui.selected_merchant") %></span>
                    </span>
                  <% end %>
                <% else %>
                  <%= render(Shadcn::DropdownMenu::Item.new(tag: :button, type: "submit", name: "selected_merchant_id", value: account.public_id, class: "w-full items-start whitespace-normal text-left [overflow-wrap:anywhere]")) do %>
                    <%= billing_icon("building-storefront") %>
                    <span class="min-w-0">
                      <span class="block font-semibold"><%= account.display_name %></span>
                      <span class="block"><%= t("billing.ui.business_states.#{account.status}") %></span>
                    </span>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
