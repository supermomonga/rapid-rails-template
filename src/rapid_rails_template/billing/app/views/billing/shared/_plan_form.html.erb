<%= render(Shadcn::Card.new) do %>
  <%= render(Shadcn::Card::Content.new(class: "space-y-4")) do %>
    <%= render "billing/shared/errors", errors: @plan.errors.full_messages %>
    <%= form_with model: @plan, scope: :plan, url: destination, class: "space-y-6" do |form| %>
      <%= render(Shadcn::Field::Set.new) do %>
        <%= render(Shadcn::Field::Legend.new) { t("billing.ui.plan_terms") } %>
        <%= render(Shadcn::Field::Group.new) do %>
          <%= render(Shadcn::Field.new) do %>
            <%= render(Shadcn::Field::Label.new(for: form.field_id(:name))) { t("billing.ui.name") } %>
            <%= form.text_field :name, required: true, class: Shadcn::Input.classes %>
          <% end %>
          <%= render(Shadcn::Field.new) do %>
            <%= render(Shadcn::Field::Label.new(for: form.field_id(:description))) { t("billing.ui.description") } %>
            <%= form.text_area :description, rows: 4, class: Shadcn::Textarea.classes %>
          <% end %>
          <%= render(Shadcn::Field.new) do %>
            <%= render(Shadcn::Field::Label.new(for: form.field_id(:price_usdc))) { t("billing.ui.price") } %>
            <%= form.text_field :price_usdc, value: params.dig(:plan, :price_usdc) || (@plan.amount_units && Billing::Amount.format(@plan.amount_units)), inputmode: "decimal", required: true, class: Shadcn::Input.classes %>
          <% end %>
          <%= render(Shadcn::Field.new) do %>
            <%= render(Shadcn::Field::Label.new(for: form.field_id(:period_days))) { t("billing.ui.period_days") } %>
            <%= form.number_field :period_days, min: 1, max: 36500, required: true, class: Shadcn::Input.classes %>
          <% end %>
        <% end %>
        <%= render(Shadcn::Field::Description.new) { t("billing.ui.plan_change_help") } %>
      <% end %>
      <%= render(Shadcn::Field::Set.new) do %>
        <%= render(Shadcn::Field::Legend.new) { t("billing.ui.accepted_chains") } %>
        <%= hidden_field_tag "plan[chain_ids][]", "" %>
        <%= render(Shadcn::Field::Group.new) do %>
          <% Billing::Chains::ALL.each_value do |chain| %>
            <%= render(Shadcn::Field.new(orientation: :horizontal)) do %>
              <%= render(Shadcn::Checkbox.new(id: "plan_chain_#{chain.id}", name: "plan[chain_ids][]", value: chain.id, checked: @plan.chain_ids.include?(chain.id))) %>
              <%= render(Shadcn::Field::Label.new(for: "plan_chain_#{chain.id}")) { chain.name } %>
            <% end %>
          <% end %>
          <%= render(Shadcn::Field.new(orientation: :horizontal)) do %>
            <%= form.hidden_field :accepting_subscriptions, value: "0", id: nil %>
            <%= render(Shadcn::Checkbox.new(id: form.field_id(:accepting_subscriptions), name: form.field_name(:accepting_subscriptions), value: "1", checked: @plan.accepting_subscriptions)) %>
            <%= render(Shadcn::Field::Label.new(for: form.field_id(:accepting_subscriptions))) { t("billing.ui.accepting") } %>
          <% end %>
        <% end %>
        <%= render(Shadcn::Field::Description.new) { t("billing.ui.accepting_help") } %>
      <% end %>
      <div class="flex flex-wrap justify-end gap-2"><%= link_to t("billing.ui.back"), back, class: action_button_classes(:quiet) %><%= form.submit t("billing.ui.save"), class: action_button_classes(:primary) %></div>
    <% end %>
  <% end %>
<% end %>
