<% history = params[:tab] == "payments" %>
<% detail_path = buyer ? account_subscription_path(@subscription) : (refund_area == "admin" ? admin_subscription_path(@subscription) : merchant_sale_path(@subscription)) %>
<%= with_tab tabs: [ApplicationHelper::Tab.new(name: billing_label("contract_details", "document-text"), path: detail_path, is_active: -> { !history }), ApplicationHelper::Tab.new(name: billing_label("payments", "banknotes"), path: "#{detail_path}?tab=payments", is_active: -> { history })], aria_label: t("billing.ui.contract_details") do %>
  <% if history %>
    <%= render "billing/shared/payments", charges: @charges, area: refund_area, show_contract: false %>
    <%= render "billing/shared/pagination" %>
  <% else %>
    <div class="space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0"><h2 class="text-xl font-semibold break-words"><%= @subscription.plan_name %></h2><p class="mt-2 text-lg font-semibold tabular-nums"><%= t("billing.ui.price_period", amount: billing_amount(@subscription.amount_units), days: @subscription.period_seconds / 86400) %></p></div>
        <%= render "billing/shared/subscription_status", subscription: @subscription %>
      </div>
      <% if @subscription.ended_at %>
        <%= render(Shadcn::Alert.new) do %>
          <%= billing_icon("check-circle") %><%= render(Shadcn::Alert::Description.new) { t("billing.ui.ended_help") } %>
        <% end %>
      <% elsif @subscription.cancel_requested_at %>
        <%= render(Shadcn::Alert.new) do %>
          <%= billing_icon("clock") %><%= render(Shadcn::Alert::Description.new) { t("billing.ui.cancelled_help") } %>
        <% end %>
      <% elsif @subscription.paid_until && Time.current >= @subscription.paid_until && @subscription.usable? %>
        <%= render(Shadcn::Alert.new) do %>
          <%= billing_icon("exclamation-triangle") %><%= render(Shadcn::Alert::Description.new) { t("billing.ui.grace_help", until: l(@subscription.paid_until + Billing::Setting.current.grace_hours.hours, format: :long)) } %>
        <% end %>
      <% elsif !@subscription.paid_until %>
        <%= render(Shadcn::Alert.new) do %>
          <%= billing_icon("clock") %><%= render(Shadcn::Alert::Description.new) { t("billing.ui.initial_pending") } %>
        <% end %>
      <% end %>
      <dl class="grid gap-4 sm:grid-cols-2">
        <div><dt class="text-muted-foreground"><%= t("billing.ui.seller") %></dt><dd class="break-words"><%= @subscription.seller_name %></dd></div>
        <% if refund_area %><div><dt class="text-muted-foreground"><%= t("billing.ui.buyer") %></dt><dd class="break-words"><%= @subscription.buyer_name %></dd></div><% end %>
        <div><dt class="text-muted-foreground"><%= t("billing.ui.chain") %></dt><dd><%= Billing::Chains.fetch(@subscription.chain_id).name %></dd></div>
        <div><dt class="text-muted-foreground"><%= t("billing.ui.started_at") %></dt><dd><%= l(@subscription.starts_at, format: :long) %></dd></div>
        <div><dt class="text-muted-foreground"><%= t("billing.ui.paid_until") %></dt><dd class="font-semibold"><%= @subscription.paid_until ? l(@subscription.paid_until, format: :long) : t("billing.ui.not_paid") %></dd></div>
        <div><dt class="text-muted-foreground"><%= t("billing.ui.permission") %></dt><dd><%= t(@subscription.revoked_at ? "billing.ui.revoked" : (@subscription.cancel_requested_at ? "billing.ui.revoking" : (@subscription.signature.blank? ? "billing.ui.signature_pending" : "billing.ui.permission_active"))) %></dd></div>
        <div class="sm:col-span-2"><dt class="text-muted-foreground"><%= t("billing.ui.payer") %></dt><dd class="break-all font-mono text-sm"><%= @subscription.payer_address %></dd></div>
      </dl>
      <% if buyer && !@subscription.cancel_requested_at && !@subscription.ended_at %>
        <% if @subscription.signature.blank? %>
          <%= render(Shadcn::Card.new) do %>
            <%= render(Shadcn::Card::Content.new) { render "billing/shared/checkout", plan: @subscription.plan, chain_ids: [@subscription.chain_id], subscription: @subscription } %>
          <% end %>
        <% end %>
        <div class="flex flex-wrap justify-end gap-2"><%= link_to t("billing.ui.cancel_subscription"), cancellation_account_subscription_path(@subscription), class: action_button_classes(:destructive) %></div>
      <% end %>
    </div>
  <% end %>
<% end %>
