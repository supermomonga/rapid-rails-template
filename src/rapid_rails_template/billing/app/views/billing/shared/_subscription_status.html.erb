<% state = billing_subscription_state(subscription) %>
<% variants = {
  "pending" => :secondary,
  "active" => :default,
  "grace" => :outline,
  "cancelling" => :outline,
  "ended" => :secondary
} %>
<%= render(Shadcn::Badge.new(variant: variants.fetch(state), data: { billing_state: true })) { t("billing.states.#{state}") } %>
