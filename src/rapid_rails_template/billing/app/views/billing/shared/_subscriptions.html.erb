<% if @subscriptions.empty? %>
  <%= render "billing/shared/empty", icon: "credit-card", title: t("billing.ui.no_subscriptions"), description: t("billing.ui.empty_contracts_help") %>
<% else %>
  <%= render(Shadcn::Item::Group.new(tag: :ul, aria: { label: t('billing.ui.subscriptions') })) do %>
    <% @subscriptions.each do |subscription| %>
      <%= render(Shadcn::Item.new(tag: :li, variant: :outline, data: { billing_subscription: true })) do %>
        <%= render(Shadcn::Item::Media.new) { billing_icon("credit-card") } %>
        <%= render(Shadcn::Item::Content.new(class: "min-w-0")) do %>
          <%= render(Shadcn::Item::Title.new) { link_to subscription.plan_name, public_send("#{destination}_path", subscription), class: "break-words text-primary underline underline-offset-4" } %>
          <p class="break-words text-muted-foreground"><%= destination == "account_subscription" ? subscription.seller_name : subscription.buyer_name %></p>
          <%= render "billing/shared/subscription_status", subscription: subscription %>
        <% end %>
        <dl class="grid w-full gap-3 sm:grid-cols-3">
          <div><dt class="text-muted-foreground"><%= t("billing.ui.price") %></dt><dd class="font-semibold tabular-nums" data-billing-amount><%= billing_amount(subscription.amount_units) %> USDC</dd></div>
          <div><dt class="text-muted-foreground"><%= t("billing.ui.chain") %></dt><dd><%= Billing::Chains.fetch(subscription.chain_id).name %></dd></div>
          <div><dt class="text-muted-foreground"><%= t("billing.ui.paid_until") %></dt><dd><%= subscription.paid_until ? l(subscription.paid_until, format: :long) : t("billing.ui.not_paid") %></dd></div>
        </dl>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<%= render "billing/shared/pagination" %>
