<% if @subscriptions.empty? %>
  <%= render "billing/shared/empty", icon: "credit-card", title: t("billing.ui.no_subscriptions"), description: t("billing.ui.empty_contracts_help") %>
<% else %>
  <ul class="list" aria-label="<%= t('billing.ui.subscriptions') %>">
    <% @subscriptions.each do |subscription| %>
      <li class="list-row" data-billing-subscription>
        <%= billing_icon("credit-card") %>
        <div class="min-w-0 list-col-grow space-y-2">
          <%= link_to subscription.plan_name, public_send("#{destination}_path", subscription), class: "link font-semibold break-words" %>
          <p class="text-base-content/70 break-words"><%= destination == "account_subscription" ? subscription.seller_name : subscription.buyer_name %></p>
          <%= render "billing/shared/subscription_status", subscription: subscription %>
        </div>
        <dl class="list-col-wrap grid gap-3 sm:grid-cols-3">
          <div><dt class="text-base-content/70"><%= t("billing.ui.price") %></dt><dd class="font-semibold tabular-nums" data-billing-amount><%= billing_amount(subscription.amount_units) %> USDC</dd></div>
          <div><dt class="text-base-content/70"><%= t("billing.ui.chain") %></dt><dd><%= Billing::Chains.fetch(subscription.chain_id).name %></dd></div>
          <div><dt class="text-base-content/70"><%= t("billing.ui.paid_until") %></dt><dd><%= subscription.paid_until ? l(subscription.paid_until, format: :long) : t("billing.ui.not_paid") %></dd></div>
        </dl>
      </li>
    <% end %>
  </ul>
<% end %>
<%= render "billing/shared/pagination" %>
