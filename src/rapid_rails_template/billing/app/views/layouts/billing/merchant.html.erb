<% content_for :with_menu_navigation, flush: true do %>
  <div data-controller="billing-navigation">
  <%= render(Shadcn::NavigationMenu.new(class: "w-full max-w-none flex-none flex-col items-stretch justify-start rounded-lg border bg-card p-2 text-card-foreground", aria: { label: t('billing.ui.merchant_menu') })) do %>
    <p class="px-2 py-1 text-sm font-semibold text-muted-foreground desktop:hidden" data-with-menu-mobile-category><%= t("billing.ui.merchant_area") %></p>
    <div class="overflow-x-auto desktop:overflow-visible" data-with-menu-scroll>
      <%= render(Shadcn::NavigationMenu::List.new(class: "w-max min-w-full flex-none justify-start desktop:w-full desktop:flex-col desktop:items-stretch", data: { with_menu_items: true })) do %>
        <%= render(Shadcn::NavigationMenu::Item.new(class: "px-2 py-1 text-sm font-semibold text-muted-foreground max-desktop:hidden")) { t("billing.ui.merchant_area") } %>
        <%= render "billing/shared/merchant_navigation" %>
      <% end %>
    </div>
  <% end %>
  </div>
  <%= render "billing/shared/merchant_selector" %>
<% end %>
<%= render layout: "layouts/with_menu" do %>
  <div data-controller="billing-navigation">
    <% if params[:merchant_id].present? %>
      <p class="mb-4 font-semibold break-words"><%= merchant_account.display_name %> <%= render(Shadcn::Badge.new(variant: { "active" => :default, "closing" => :outline, "closed" => :secondary }.fetch(merchant_account.status))) { t("billing.ui.business_states.#{merchant_account.status}") } %></p>
      <% unless merchant_account.status == "active" %>
        <%= render(Shadcn::Alert.new(class: "mb-4")) do %>
          <%= billing_icon("clock") %>
          <%= render(Shadcn::Alert::Description.new) { t("billing.ui.business_state_help.#{merchant_account.status}") } %>
        <% end %>
      <% end %>
    <% end %>
    <%= yield %>
  </div>
<% end %>
